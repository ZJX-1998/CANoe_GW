LIN_description_file;
LIN_protocol_version = "2.1";
LIN_language_version = "2.1";
LIN_speed = 19.2 kbps;

Nodes {
  Master: CDCU, 10 ms, 0.1 ms ;
  Slaves: ALC, ALP ;
}

Signals {
  ALC_ResponseError: 1, 0, ALC, CDCU;//通信响应状态位
  ALC_Error_Open: 1, 0, ALC, CDCU;//点、线光源开路故障
  ALC_Error_Short: 1, 0, ALC, CDCU;//点、线光源短路故障
  ALC_Error_High: 1, 0, ALC, CDCU;//输入电压高故障
  ALC_Error_Low: 1, 0, ALC, CDCU;//输入电压过低故障
  ALC_Error_Reverse: 1, 0, ALC, CDCU;//输入电压反向故障
  ALC_01ZoneSelt: 1, 0, ALC, CDCU;//仪表区域
  ALC_02ZoneSelt: 1, 0, ALC, CDCU;//中控区域
  ALC_03ZoneSelt: 1, 0, ALC, CDCU;//前门区域
  ALC_04ZoneSelt: 1, 0, ALC, CDCU;//后门区域
  ALC_05ZoneSelt: 1, 0, ALC, CDCU;//车顶区域
  ALC_06ZoneSelt: 1, 0, ALC, CDCU;//预留卧铺区域
  ALC_07ZoneSelt: 1, 0, ALC, CDCU;//预留
  ALC_08ZoneSelt: 1, 0, ALC, CDCU;//预留
  ALC_09ZoneSelt: 1, 0, ALC, CDCU;//预留
  ALC_10ZoneSelt: 1, 0, ALC, CDCU;//预留
  AmbLigBri: 7, 0, ALC, CDCU;//氛围灯亮度值
  ALC_01Zone: 1, 0, CDCU, ALC;//仪表区域
  ALC_02Zone: 1, 0, CDCU, ALC;//中控区域
  ALC_03Zone: 1, 0, CDCU, ALC;//前门区域
  ALC_04Zone: 1, 0, CDCU, ALC;//后门区域
  ALC_05Zone: 1, 0, CDCU, ALC;//车顶区域
  ALC_06Zone: 1, 0, CDCU, ALC;//预留卧铺区域
  ALC_07Zone: 1, 0, CDCU, ALC;//预留
  ALC_08Zone: 1, 0, CDCU, ALC;//预留
  ALC_09Zone: 1, 0, CDCU, ALC;//预留
  ALC_10Zone: 1, 0, CDCU, ALC;//预留
  ALCLigBriAdj: 7, 0, CDCU, ALC;//氛围灯亮度目标值
  ALCLigColorAdj: 8, 0, CDCU, ALC;//氛围灯颜色
  ALCLigFadeINorOUTStepTi: 7, 0, CDCU, ALC;//时长信号
  ALCLigFlngModSel: 6, 0, CDCU, ALC;//氛围灯模式指令
  DymALCLigLevelSig: 7, 0, CDCU, ALC;//尺度信号（控制点亮长度（尺度）
  DymALCLigDirSig: 3, 0, CDCU, ALC;//动态氛围灯渐亮\渐灭\颜色切换方向信号/动态面板设定位置信号
  ALCModLocSig: 3, 0, CDCU, ALC;//氛围灯模组方位使能（左、右、中、顶部）信号
  ALCLigModRepOrdIdeSig: 1, 0, CDCU, ALC;//重复指令识别信号
  ALCLigModTimCabSig: 1, 0, CDCU, ALC, ALP;//时间校准信号（用于动态面板执行长时动态效果，避免自计时误差引起的整车效果不一直（外部晶振计时），在整车动态面板执行长时动态效果时，按照动态效果周期时间的倍数设置固定间隔周期循环发送本信号，相关节点信号赋值1，模式信号赋值当前执行模式信号，其它信号信号赋值0，时间校准信号赋值0~1循环发送，氛围灯模组每接收到一次变化的时间校准信号，动态效果同时重新启动一次
  ALP_ResponseError: 1, 0, ALP, CDCU;//通信响应状态位
  ALP_Error_Open: 1, 0, ALP, CDCU;//点、线光源开路故障
  ALP_Error_Short: 1, 0, ALP, CDCU;//点、线光源短路故障
  ALP_Error_High: 1, 0, ALP, CDCU;//输入电压高故障
  ALP_Error_Low: 1, 0, ALP, CDCU;//输入电压过低故障
  ALP_Error_Reverse: 1, 0, ALP, CDCU;//输入电压反向故障
  ALP_01Selt: 1, 0, ALP, CDCU;//发光面板
  ALPLigBri: 7, 0, ALP, CDCU;//发光面板亮度值
  ALP_Zone: 1, 0, CDCU, ALP;//发光面板
  ALPLigBriAdj: 7, 0, CDCU, ALP;//发光面板亮度目标值
  ALPLigColorAdj: 8, 0, CDCU, ALP;//发光面板颜色
  ALPLigFadeINorOUTStepTi: 7, 0, CDCU, ALP;//时长信号
  ALPLigFlngModSel: 6, 0, CDCU, ALP;//发光面板模式指令
  DymALPLigLevelSig: 7, 0, CDCU, ALP;//尺度信号（控制点亮长度（尺度）
  DymALPLigDirSig: 3, 0, CDCU, ALP;//动态发光面板渐亮\渐灭\颜色切换方向信号/动态面板设定位置信号
  ALPModLocSig: 3, 0, CDCU, ALP;//发光面板模组方位使能（左、右、中、顶部）信号
  ALPLigModRepOrdIdeSig: 1, 0, CDCU, ALP;//重复指令识别信号
}

