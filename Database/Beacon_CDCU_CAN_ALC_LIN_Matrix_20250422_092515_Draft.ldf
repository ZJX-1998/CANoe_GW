Node_attributes {
  ALC{
    LIN_protocol = "2.1" ;
    configured_NAD = 46 ;
    initial_NAD = 46 ;
    product_id = 0x0, 0x0, 0 ;
    response_error = ALC_ResponseError ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      ALC_1 ;
      CDCU_ALCCtrl ;
    }
  }
  ALP{
    LIN_protocol = "2.1" ;
    configured_NAD = 47 ;
    initial_NAD = 47 ;
    product_id = 0x0, 0x0, 0 ;
    response_error = ALP_ResponseError ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      ALPSts ;
      CDCU_ALCCtrl ;
      CDCU_ALPCtrl ;
    }
  }
}

Schedule_tables {
 Dynamic {
    ALC_1 delay 20 ms ;
    CDCU_ALCCtrl delay 20 ms ;
    ALPSts delay 20 ms ;
    CDCU_ALPCtrl delay 20 ms ;
  }
}

