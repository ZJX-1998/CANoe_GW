    ALPLigBri, 16 ;
  }
  CDCU_ALPCtrl: 0x37, CDCU, 8 {
    ALP_Zone, 0 ;
    ALPLigBriAdj, 16 ;
    ALPLigColorAdj, 24 ;
    ALPLigFadeINorOUTStepTi, 32 ;
    ALPLigFlngModSel, 40 ;
    DymALPLigLevelSig, 48 ;
    DymALPLigDirSig, 56 ;
    ALPModLocSig, 59 ;
    ALPLigModRepOrdIdeSig, 62 ;
  }
}

