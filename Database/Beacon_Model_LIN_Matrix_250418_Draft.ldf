Schedule_tables {
 Beacon_LIN1 {
    EXVCtrl_Chiller1 delay 10 ms ;
    EXVSts_Chiller1 delay 10 ms ;
    TWV1_Cmd delay 10 ms ;
    TWV1_Sts delay 10 ms ;
    FWV_Cmd delay 10 ms ;
    FWV_Sts delay 50 ms ;
  }
}

