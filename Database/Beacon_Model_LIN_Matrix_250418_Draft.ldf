LIN_description_file;
LIN_protocol_version = "2.1";
LIN_language_version = "2.1";
LIN_speed = 19.2 kbps;

Nodes {
  Master: VDCU, 10 ms, 0.1 ms ;
  Slaves: Chiller_1, WAY3_1, WAY4 ;
}

Signals {
  Chiller1_EXV_Cmd_Set_Rq: 16, 0, VDCU, Chiller_1;//Positon Request (0~576):phys=raw halfstep 0x240~0xFFFF:not defined
  Chiller1_EXV_Cmd_Move_Enbl: 1, 0, VDCU, Chiller_1;//Move Enable
  Chiller1_EXV_Cmd_Init_Rq: 3, 0, VDCU, Chiller_1;//Initialization Request
  Chiller1_RsErr_EXV: 1, 0, Chiller_1, VDCU;//Communication Error Status
