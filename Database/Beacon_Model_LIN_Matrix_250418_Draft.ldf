  Chiller1_EXV_OvrTemp_Warn: 2, 0, Chiller_1, VDCU;//Temperature Status
  Chiller1_EXV_Pos: 16, 0, Chiller_1, VDCU;//Current Position (0~576):phys=raw halfstep 0x240~0xFFFF:not defined
  TWV1_PosSetReq: 8, 0, VDCU, WAY3_1;//位置请求
  TWV1_MoveEnable: 1, 0, VDCU, WAY3_1;//使能
  TWV1_AngSenSts: 2, 0, WAY3_1, VDCU;//角度传感器状态
  TWV1_TempSts: 2, 0, WAY3_1, VDCU;//温度状态
  TWV1_VoltSts: 2, 0, WAY3_1, VDCU;//电压状态
  TWV1_MotSts: 2, 0, WAY3_1, VDCU;//电机状态
  TWV1_PosRes: 8, 0, WAY3_1, VDCU;//位置反馈
  TWV1_RunSts: 1, 0, WAY3_1, VDCU;//电机运行状态
  TWV1_BlkSts: 1, 0, WAY3_1, VDCU;//堵转状态
  TWV1_TimeOut: 1, 0, WAY3_1, VDCU;//运行超时
  TWV1_CmdPosErr: 1, 0, WAY3_1, VDCU;//位置发送错误状态
  TWV1_ErrResp: 1, 0, WAY3_1, VDCU;//通讯状态
  FWV1_PosSetReq: 8, 0, VDCU, WAY4;//位置请求
  FWV1_MoveEnable: 1, 0, VDCU, WAY4;//使能
  FWV1_AngSenSts: 2, 0, WAY4, VDCU;//角度传感器状态
  FWV1_TempSts: 2, 0, WAY4, VDCU;//温度状态
  FWV1_VoltSts: 2, 0, WAY4, VDCU;//电压状态
  FWV1_MotSts: 2, 0, WAY4, VDCU;//电机状态
  FWV1_PosRes: 8, 0, WAY4, VDCU;//位置反馈
  FWV1_RunSts: 1, 0, WAY4, VDCU;//电机运行状态
  FWV1_BlkSts: 1, 0, WAY4, VDCU;//堵转状态
  FWV1_TimeOut: 1, 0, WAY4, VDCU;//运行超时
  FWV1_CmdPosErr: 1, 0, WAY4, VDCU;//位置发送错误状态
  FWV1_ErrResp: 1, 0, WAY4, VDCU;//通讯状态
}

