LIN_description_file;
LIN_protocol_version = "2.1";
LIN_language_version = "2.1";
LIN_speed = 19.2 kbps;

Nodes {
  Master: VDCU, 10 ms, 0.1 ms ;
  Slaves: RLS, SWS, SGM_S, SGM_IP ;
}

Signals {
  BCM_Dimm_Swt: 4, 10, VDCU, SGM_S, SGM_IP;//Dimmer Switch
  BCM_AirHornSetSts_Sts: 1, 0, VDCU, SGM_IP;//Gas Horn status
  BCM_Temp_Cabin_Slpr: 8, 255, VDCU, SGM_S;//后空调室内温度采集信号 温度范围在-40~100
  BCM_RearHeadlight_Sts: 1, 0, VDCU, SGM_IP;//Rear Light status
  BCM_ACFrontDefrostDisp_Sts: 2, 0, VDCU, SGM_IP;//AC Front Defrost status
  ACBlowerLevelDisp: 4, 0, VDCU, SGM_IP;//风量档位显示
  BCM_PosnLigjtReq_Sts: 1, 0, VDCU, SGM_S, SGM_IP;//Position lamp status
  BCM_ACOffDisp_Sts: 2, 0, VDCU, SGM_S;//AC off status
  BCM_ACTimingRunDisp_Sts: 2, 0, VDCU, SGM_S;//AC Timing Run status
  BCM_ADAS_Sts: 3, 0, VDCU;//ADAS lamp status
  BCM_Status_IGN: 2, 0, VDCU, RLS;//Ignition status 点火开关状态
  BCM_CMD_AutoWiper: 1, 0, VDCU, RLS;//Wiper Switch Auto Enabled  雨刮开关处于自动档位置
  BCM_RQ_FrontWash: 1, 0, VDCU, RLS;//Front Washer Switch is Activated 前洗涤开关处于激活状态
  BCM_ParkPosition: 1, 0, VDCU, RLS;//This signal is set when the wiper blade is in park position. This signal is used by the Sensor to mask overwipes and to check that the wiper motor reacts to the commands from the sensor.  这个信号表示雨刮处于停止位置。这个信号被传感器用来屏蔽过度刮刷，并且确认电机是按照雨量的命令工作的。(此信号在离开ParkPosition或者到达ParkPosition时发出延迟小于100ms)
  BCM_RainSensitivity: 3, 0, VDCU, RLS;//rain sensor sensitivity volume 雨量灵敏度
  BCM_CMD_AutoLight: 1, 0, VDCU, RLS;//Light Switch Auto Enabled  灯光开关处于自动档位置
  BCM_BladesTurningPoint: 1, 0, VDCU, RLS;//This signal is set when the wiper blade is in TurningPoint position. This signal is used by the Sensor to mask overwipes and to check that the wiper motor reacts to the commands from the sensor. 雨刮电机远离停止位置的换向点。
  BCM_SPD_Vehicle: 13, 8190, VDCU, RLS;//Current Vehicle Speed 当前车速
  RLS_MsgCounter: 4, 0, RLS, VDCU;//This is a counter, which will be increased after having sent a message to BCM succesfully 这是一个计数器,当RLS每成功发送给BCM一个消息，就增加1
  RLS_RQ_WiperSPD: 2, 0, RLS, VDCU;//The Sensor requested wiper speed 雨量传感器请求的雨刮速度.
  RLS_RQ_LowBeam: 1, 0, RLS, VDCU;//Auto low beam request 近光灯点亮请求
  RLS_RQ_PositionLamp: 1, 0, RLS, VDCU;//Auto position lamp request 位置灯点亮请求
  RLS_Fault_Rain: 1, 0, RLS, VDCU;//Rain sensor fault status 雨量传感器故障状态
  RLS_Fault_Light: 1, 0, RLS, VDCU;//Light sensor fault status 光亮传感器故障状态
  RLS_REP_Error: 1, 0, RLS, VDCU;//RLS LIN response error RLS通讯故障状态
  RLS_VOLT_Error: 2, 0, RLS, VDCU;//RLS Voltage error RLS检测电池电压错误
  RLS_Brightness_FW: 10, 1023, RLS, VDCU;//The Visible Ambientlight (540nm) measured by Spot FW 可见环境光亮度
  RLS_Rain_Intensity: 4, 0, RLS, VDCU;//This signal delivers information about rain intensity: from 0%(no rain) to 100% (very heavy rain) 降雨强度：从0%到100%
  RLS_BigLamp_Threshold_Nr: 10, 0, RLS, VDCU;//大灯开启阀值信号
  RLS_RainCloseWin_Str: 1, 0, RLS, VDCU;//雨天关窗信号
  RLS_WiperSPD_FuncErr: 2, 0, RLS, VDCU;//雨刮功能安全故障
  RLS_RQ_LowBeam_FuncErr: 2, 0, RLS, VDCU;//近光灯功能安全故障
  RLS_CheckSum: 8, 0, RLS, VDCU;//E2E Checksum
  SGM_S_Unlock_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  Unlock
  SGM_S_Lock_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  Lock
  SGM_S_WLM_FL_Swt: 3, 0, SGM_S, VDCU;//The Switch of the  window
  SGM_S_WLM_FR_Swt: 3, 0, SGM_S, VDCU;//The Switch of the  window
  SGM_S_VolumePlus_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  AC Volume plus
  SGM_S_VolumeMinus_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  AC Volume minus
  SGM_S_ACOnOrOff_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  AC on or off
  SGM_S_BlowerLvlPlus_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  AC Blowe plus
  SGM_S_BlowerLvlMinus_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  AC Blowe minus
  SGM_S_ACTempPlus_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  AC Temperature plus
  SGM_S_ACTempMinus_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  AC Temperature minus
  SGM_S_ACTimingRun_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  AC Timing Run
  SGM_S_CMSStart_Swt: 2, 0, SGM_S, VDCU;//The Switch of the  CMS start
  SGM_S_F_LINError: 1, 0, SGM_S, VDCU;//This signal shows one or more failures related to LIN communication.
  SGM_IP_HornType_Swt: 2, 0, SGM_IP, VDCU;//The Switch of the  Horn Type
  SGM_IP_RearLight_Swt: 2, 0, SGM_IP, VDCU;//The Switch of the  Rear light
  SGM_IP_ACOff_Swt: 2, 0, SGM_IP, VDCU;//The Switch of the  AC off
  SGM_IP_BlowerLvlPlus_Swt: 2, 0, SGM_IP, VDCU;//The Switch of the  AC Blowe plus
  SGM_IP_BlowerLvlMinus_Swt: 2, 0, SGM_IP, VDCU;//The Switch of the  AC Blowe minus
  SGM_IP_ACTempPlus_Swt: 2, 0, SGM_IP, VDCU;//The Switch of the  AC Temperature plus
  SGM_IP_ACTempMinus_Swt: 2, 0, SGM_IP, VDCU;//The Switch of the  AC Temperature minus
  SGM_IP_ACFrontDefrost_Swt: 2, 0, SGM_IP, VDCU;//The Switch of the  AC Front Defrost
  SGM_IP_F_LINError: 1, 0, SGM_IP, VDCU;//This signal shows one or more failures related to LIN communication.
}

Diagnostic_signals {
  MasterReqB0: 8, 0 ;
  MasterReqB1: 8, 0 ;
  MasterReqB2: 8, 0 ;
  MasterReqB3: 8, 0 ;
  MasterReqB4: 8, 0 ;
  MasterReqB5: 8, 0 ;
  MasterReqB6: 8, 0 ;
  MasterReqB7: 8, 0 ;
  SlaveRespB0: 8, 0 ;
  SlaveRespB1: 8, 0 ;
  SlaveRespB2: 8, 0 ;
  SlaveRespB3: 8, 0 ;
  SlaveRespB4: 8, 0 ;
  SlaveRespB5: 8, 0 ;
  SlaveRespB6: 8, 0 ;
  SlaveRespB7: 8, 0 ;
}
Frames {
  VDCU_LIN2_1: 0x35, VDCU, 8 {
    BCM_Dimm_Swt, 0 ;
    BCM_AirHornSetSts_Sts, 10 ;
    BCM_Temp_Cabin_Slpr, 16 ;
    BCM_RearHeadlight_Sts, 31 ;
    BCM_ACFrontDefrostDisp_Sts, 40 ;
    ACBlowerLevelDisp, 42 ;
    BCM_PosnLigjtReq_Sts, 56 ;
    BCM_ACOffDisp_Sts, 57 ;
    BCM_ACTimingRunDisp_Sts, 59 ;
    BCM_ADAS_Sts, 61 ;
  }
  VDCU_LIN2_2: 0x31, VDCU, 8 {
    BCM_Status_IGN, 0 ;
    BCM_CMD_AutoWiper, 2 ;
    BCM_RQ_FrontWash, 3 ;
    BCM_ParkPosition, 4 ;
    BCM_RainSensitivity, 5 ;
    BCM_CMD_AutoLight, 8 ;
    BCM_BladesTurningPoint, 9 ;
    BCM_SPD_Vehicle, 16 ;
  }
  RLS_1: 0x23, RLS, 8 {
    RLS_MsgCounter, 0 ;
    RLS_RQ_WiperSPD, 4 ;
    RLS_RQ_LowBeam, 7 ;
    RLS_RQ_PositionLamp, 8 ;
    RLS_Fault_Rain, 9 ;
    RLS_Fault_Light, 10 ;
    RLS_REP_Error, 11 ;
    RLS_VOLT_Error, 12 ;
    RLS_Brightness_FW, 24 ;
    RLS_Rain_Intensity, 34 ;
    RLS_BigLamp_Threshold_Nr, 38 ;
    RLS_RainCloseWin_Str, 48 ;
    RLS_WiperSPD_FuncErr, 49 ;
    RLS_RQ_LowBeam_FuncErr, 51 ;
    RLS_CheckSum, 56 ;
  }
  SGM_S_1: 0x1D, SGM_S, 8 {
    SGM_S_Unlock_Swt, 0 ;
    SGM_S_Lock_Swt, 2 ;
    SGM_S_WLM_FL_Swt, 4 ;
    SGM_S_WLM_FR_Swt, 9 ;
    SGM_S_VolumePlus_Swt, 12 ;
    SGM_S_VolumeMinus_Swt, 14 ;
    SGM_S_ACOnOrOff_Swt, 16 ;
    SGM_S_BlowerLvlPlus_Swt, 18 ;
    SGM_S_BlowerLvlMinus_Swt, 20 ;
    SGM_S_ACTempPlus_Swt, 22 ;
    SGM_S_ACTempMinus_Swt, 24 ;
    SGM_S_ACTimingRun_Swt, 26 ;
    SGM_S_CMSStart_Swt, 28 ;
    SGM_S_F_LINError, 63 ;
  }
  SGM_IP_1: 0x1E, SGM_IP, 8 {
    SGM_IP_HornType_Swt, 0 ;
    SGM_IP_RearLight_Swt, 2 ;
    SGM_IP_ACOff_Swt, 4 ;
    SGM_IP_BlowerLvlPlus_Swt, 6 ;
    SGM_IP_BlowerLvlMinus_Swt, 8 ;
    SGM_IP_ACTempPlus_Swt, 10 ;
    SGM_IP_ACTempMinus_Swt, 12 ;
    SGM_IP_ACFrontDefrost_Swt, 14 ;
    SGM_IP_F_LINError, 63 ;
  }
}

Diagnostic_frames {
  MasterReq: 0x3c {
    MasterReqB0, 0 ;
    MasterReqB1, 8 ;
    MasterReqB2, 16 ;
    MasterReqB3, 24 ;
    MasterReqB4, 32 ;
    MasterReqB5, 40 ;
    MasterReqB6, 48 ;
    MasterReqB7, 56 ;
  }
  SlaveResp: 0x3d {
    SlaveRespB0, 0 ;
    SlaveRespB1, 8 ;
    SlaveRespB2, 16 ;
    SlaveRespB3, 24 ;
    SlaveRespB4, 32 ;
    SlaveRespB5, 40 ;
    SlaveRespB6, 48 ;
    SlaveRespB7, 56 ;
  }
}
Node_attributes {
  RLS{
    LIN_protocol = "2.1" ;
    configured_NAD = 35 ;
    initial_NAD = 35 ;
    product_id = 0x0, 0x0, 0 ;
    response_error = RLS_REP_Error ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      RLS_1 ;
      VDCU_LIN2_2 ;
    }
  }
  SWS{
    LIN_protocol = "2.1" ;
    configured_NAD = 24 ;
    initial_NAD = 24 ;
    product_id = 0x0, 0x0, 0 ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
  }
  SGM_S{
    LIN_protocol = "2.1" ;
    configured_NAD = 29 ;
    initial_NAD = 29 ;
    product_id = 0x0, 0x0, 0 ;
    response_error = SGM_S_F_LINError ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      SGM_S_1 ;
      VDCU_LIN2_1 ;
    }
  }
  SGM_IP{
    LIN_protocol = "2.1" ;
    configured_NAD = 30 ;
    initial_NAD = 30 ;
    product_id = 0x0, 0x0, 0 ;
    response_error = SGM_IP_F_LINError ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      SGM_IP_1 ;
      VDCU_LIN2_1 ;
    }
  }
}

Schedule_tables {
 Beacon_LIN1 {
    VDCU_LIN2_1 delay 10 ms ;
    VDCU_LIN2_2 delay 10 ms ;
    SGM_IP_1 delay 10 ms ;
    VDCU_LIN2_2 delay 10 ms ;
    RLS_1 delay 10 ms ;
    SGM_S_1 delay 10 ms ;
  }
}

